{
  "name": "inktrap-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter playground build",
    "dev": "pnpm --filter playground dev",
    "test": "pnpm -r test",
    "bench": "pnpm --filter @inktrap/react bench",
    "size": "pnpm --filter @inktrap/react size",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3"
  }
}
