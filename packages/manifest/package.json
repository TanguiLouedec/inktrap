{
  "name": "@inktrapjs/manifest",
  "version": "0.1.1",
  "description": "The inktrap font manifest format: TypeScript types and tiny helpers for describing self-hosted font families.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "import": "./dist/features.js",
      "require": "./dist/features.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanguiLouedec/inktrap.git",
    "directory": "packages/manifest"
  },
  "homepage": "https://github.com/TanguiLouedec/inktrap/tree/main/packages/manifest#readme",
  "bugs": {
    "url": "https://github.com/TanguiLouedec/inktrap/issues"
  },
  "keywords": [
    "typography",
    "font",
    "variable-fonts",
    "opentype",
    "type-design",
    "self-hosted-fonts"
  ],
  "size-limit": [
    {
      "name": "selectFace + variationSettings",
      "path": "dist/index.js",
      "import": "{ selectFace, variationSettings }",
      "limit": "300 B",
      "gzip": true
    },
    {
      "name": "featureLabel (with labels)",
      "path": "dist/features.js",
      "import": "{ featureLabel }",
      "limit": "1 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.2.0",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
